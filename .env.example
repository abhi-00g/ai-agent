# Groq API Key (free tier — 30 RPM, 14,400 RPD)
# Sign up at https://console.groq.com to get your key
GROQ_API_KEY=your_groq_api_key_here

# Tavily Web Search API Key (free tier — 1,000 searches/month)
# Sign up at https://tavily.com to get your key
TAVILY_API_KEY=your_tavily_api_key_here

# AI Cost Dashboard Telemetry (optional)
# If both are set, every LLM call is logged to your Cost Dashboard.
# If either is missing, telemetry is silently disabled.
COST_DASHBOARD_API_KEY=your_dashboard_api_key_here
COST_DASHBOARD_ENDPOINT=https://ai-cost-dashboard-rk91.onrender.com/api/v1
